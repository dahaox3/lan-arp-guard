#!/bin/sh /etc/rc.common
START=18
STOP=89
USE_PROCD=1

start_service() { /usr/sbin/lan-arp-guard start; }
stop_service() { /usr/sbin/lan-arp-guard stop; }
reload_service() { /usr/sbin/lan-arp-guard reload; }
status() { /usr/sbin/lan-arp-guard status; }
service_triggers() { procd_add_reload_trigger 'lan-arp-guard'; }
